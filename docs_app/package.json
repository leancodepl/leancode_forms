{
  "name": "advanced-forms-docs",
  "version": "0.0.17",
  "private": true,
  "scripts": {
    "build": "npm run examples:build && next build",
    "dev": "next dev",
    "start": "next start",
    "types:check": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "lint:fix": "eslint . --fix",
    "format:fix": "prettier --write .",
    "examples:generate": "node scripts/flutter-examples.mjs generate",
    "examples:watch": "node scripts/flutter-examples.mjs generate --watch",
    "examples:check": "node scripts/flutter-examples.mjs check",
    "examples:build": "node scripts/flutter-examples.mjs build",
    "examples:serve": "cd flutter && flutter run -d web-server --web-port 5333"
  },
  "dependencies": {
    "cnfast": "^0.1.0",
    "fumadocs-core": "16.14.5",
    "fumadocs-mdx": "15.3.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.14.5",
    "lucide-react": "^1.31.0",
    "next": "16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@leancodepl/eslint-config": "10.6.0",
    "@leancodepl/prettier-config": "10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "^8.5.26",
    "prettier": "^3.8.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unified": "11.0.5",
    "vercel": "^59.1.4"
  }
}
